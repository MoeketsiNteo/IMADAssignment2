<?xml version="1.0" encoding="utf-8"?>

<!-- Question screen where the user chooses if the statement is Fact or Myth -->

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/questionMain"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="#0B132B">

    <!-- This shows which question the user is currently answering -->
    <TextView
        android:id="@+id/tvQuestionNumber"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Question 1 of 5"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#5BC0BE"
        android:gravity="center"
        android:layout_marginBottom="24dp" />

    <!-- This displays the actual quiz question -->
    <TextView
        android:id="@+id/tvQuestion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Question appears here"
        android:textSize="21sp"
        android:textColor="#FFFFFF"
        android:gravity="center"
        android:padding="24dp"
        android:background="#1C2541"
        android:layout_marginBottom="28dp" />

    <!-- Button for choosing Fact -->
    <Button
        android:id="@+id/btnFact"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Fact"
        android:textSize="18sp"
        android:layout_marginBottom="12dp" />

    <!-- Button for choosing Myth -->
    <Button
        android:id="@+id/btnMyth"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Myth"
        android:textSize="18sp"
        android:layout_marginBottom="22dp" />

    <!-- This shows feedback after the user chooses an answer -->
    <TextView
        android:id="@+id/tvFeedback"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:gravity="center"
        android:layout_marginBottom="22dp" />

    <!-- Button for moving to the next question -->
    <Button
        android:id="@+id/btnNext"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Next Question"
        android:textSize="18sp" />

</LinearLayout>