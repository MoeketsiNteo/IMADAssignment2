<?xml version="1.0" encoding="utf-8"?>

<!-- Final score screen for showing the user's result -->

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scoreMain"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="26dp"
    android:background="#0B132B">

    <!-- Title for the score screen -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Challenge Complete"
        android:textSize="32sp"
        android:textStyle="bold"
        android:textColor="#5BC0BE"
        android:gravity="center"
        android:layout_marginBottom="20dp" />

    <!-- This displays the user's final score -->
    <TextView
        android:id="@+id/tvScore"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Your score: 0/5"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:gravity="center"
        android:layout_marginBottom="18dp" />

    <!-- This gives feedback based on the final score -->
    <TextView
        android:id="@+id/tvScoreFeedback"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Feedback"
        android:textSize="19sp"
        android:textColor="#D9E4EC"
        android:gravity="center"
        android:layout_marginBottom="32dp" />

    <!-- This button lets the user review the answers -->
    <Button
        android:id="@+id/btnReview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="View Correct Answers"
        android:textSize="18sp"
        android:layout_marginBottom="12dp" />

    <!-- This button restarts the quiz -->
    <Button
        android:id="@+id/btnRestart"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Try Again"
        android:textSize="18sp" />

</LinearLayout>